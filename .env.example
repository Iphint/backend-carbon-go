PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
# Optional: comma-separated origins for other devices/domains.
# Example: CORS_ORIGINS=http://192.168.1.10:5173,http://192.168.1.10:5174,https://admin.carbongo.site
CORS_ORIGINS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carbon_go
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_admin_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=7d

# Email configuration (optional - if not set, codes are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@carbongo.site
